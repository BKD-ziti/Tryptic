output/
dream_output/
mosh_out/
mosh_work/
_frames_*/
*.mp4
*.mov
*.mkv
*.m4v
*.webm
*.avi

# python / os / editor clutter
__pycache__/
*.py[cod]
.favicon.png
*.lnk
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# old copies
_backup*/
*.orig.py
